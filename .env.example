# Bu dosyayı .env olarak kopyalayın. Tüm değerler isteğe bağlıdır;
# verilmezse aşağıdaki varsayılanlar kullanılır.

# TimescaleDB — 5432 başka bir PostgreSQL tarafından kullanılıyorsa portu değiştirin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=digital_twin

REDIS_HOST=localhost
REDIS_PORT=6379

QDRANT_HOST=localhost
QDRANT_PORT=6333

MQTT_HOST=localhost
MQTT_PORT=1883

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123

# Alarm bildirimlerinin gönderildiği n8n webhook'u
N8N_WEBHOOK_URL=http://localhost:5678/webhook/anomali-alarm

# Dahili saha simülatörü (gerçek sensör verisi MQTT'den geliyorsa false yapın)
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL=5

# Panele izin verilen kaynaklar (virgülle ayırın; * = hepsi)
CORS_ORIGINS=*

# Embedding: local (all-MiniLM-L6-v2, varsayılan) | openai
EMBEDDING_BACKEND=local
# OPENAI_API_KEY=
